CC:= cc
CFLAGS:= -Wall -Werror -Wextra
HEADER:= libft.h
EXE:= atoi bzero calloc isalnum isalpha isascii isdigit isprint itoa memchr memcmp memcpy memmove memset putchar_fd putendl_fd putnbr_fd putstr_fd split strchr strdup striteri strjoin strlcat strlcpy strlen strmapi strncmp strnstr strrchr strtrim substr tolower toupper lstadd_back lstclear lstadd_front lstdelone lstiter lstlast lstmap lstnew lstsize
ATOI:= ft_atoi.c ft_isdigit.c ft_strlen.c
INIT_NODE:= ft_init_node.c ft_strdup.c ft_lstnew.c ft_strlen.c
LSTLAST:= ft_lstlast.c ${INIT_NODE}
LSTDELONE:= ft_lstdelone.c ft_free_content.c ${INIT_NODE}
LSTITER:= ft_lstiter.c ft_isalpha.c ft_lstclear.c ft_lstadd_back.c ${LSTDELONE}
VALGRIND = valgrind
default:
	@echo "Please specify which test you are running\nDo not forget to comment out main of the tested file AND ONLY of the tested file!"
atoi: ft_atoi.c ft_isdigit.c
	${CC} ${CFLAGS} $^ -o $@
bzero: ft_bzero.c ft_memset.c
	${CC} ${CFLAGS} $^ -o $@
calloc: ft_calloc.c ft_bzero.c ft_memset.c
	${CC} ${CFLAGS} $^ -o $@
isalnum: ft_isalnum.c ft_isalpha.c ${ATOI}
	${CC} ${CFLAGS} $^ -o $@
isalpha: ft_isalpha.c ${ATOI}
	${CC} ${CFLAGS} $^ -o $@
isascii: ft_isascii.c ${ATOI}
	${CC} ${CFLAGS} $^ -o $@
isdigit: ${ATOI}
	${CC} ${CFLAGS} $^ -o $@
isprint: ft_isprint.c ${ATOI}
	${CC} ${CFLAGS} $^ -o $@
itoa: ft_itoa.c ${ATOI}
	${CC} ${CFLAGS} $^ -o $@
memchr: ft_memchr.c
	${CC} ${CFLAGS} $^ -o $@
memcmp: ft_memcmp.c
	${CC} ${CFLAGS} $^ -o $@
memcpy: ft_memcpy.c ft_strlen.c
	${CC} ${CFLAGS} $^ -o $@
memmove: ft_memmove.c ft_memcpy.c ft_strlen.c
	${CC} ${CFLAGS} $^ -o $@
memset: ft_memset.c
	${CC} ${CFLAGS} $^ -o $@
putchar_fd: ft_putchar_fd.c
	${CC} ${CFLAGS} $^ -o $@
putendl_fd: ft_putchar_fd.c
	${CC} ${CFLAGS} $^ -o $@
putnbr_fd: ft_putchar_fd.c
	${CC} ${CFLAGS} $^ -o $@
putstr_fd: ft_putchar_fd.c
	${CC} ${CFLAGS} $^ -o $@
split: ft_split.c
	${CC} ${CFLAGS} $^ -o $@
strchr: ft_strchr.c ft_strlen.c
	${CC} ${CFLAGS} $^ -o $@
strdup: ft_strdup.c ft_strlen.c
	${CC} ${CFLAGS} $^ -o $@
striteri: ft_striteri.c
	${CC} ${CFLAGS} $^ -o $@
strjoin: ft_strjoin.c ft_strlcpy.c ft_strlcat.c ft_strlen.c
	${CC} ${CFLAGS} $^ -o $@
strlcat: ft_strlcat.c ft_strlen.c ${ATOI}
	${CC} ${CFLAGS} $^ -o $@ -lbsd
strlcpy: ft_strlcpy.c ft_strlen.c
	${CC} ${CFLAGS} $^ -o $@ -lbsd
strlen: ft_strlen.c
	${CC} ${CFLAGS} $^ -o $@
strmapi: ft_strmapi.c ft_strlen.c
	${CC} ${CFLAGS} $^ -o $@
strncmp: ft_strncmp.c ${ATOI}
	${CC} ${CFLAGS} $^ -o $@
strnstr: ft_strnstr.c ft_strlen.c ${ATOI}
	${CC} ${CFLAGS} $^ -o $@ -lbsd
strrchr: ft_strrchr.c ft_strlen.c ${ATOI}
	${CC} ${CFLAGS} $^ -o $@
strtrim: ft_strtrim.c ft_strlen.c ft_strlcpy.c
	${CC} ${CFLAGS} $^ -o $@
substr: ft_substr.c ft_strlen.c ft_strlcpy.c ${ATOI}
	${CC} ${CFLAGS} $^ -o $@
tolower: ft_tolower.c ${ATOI}
	${CC} ${CFLAGS} $^ -o $@
toupper: ft_toupper.c ${ATOI}
	${CC} ${CFLAGS} $^ -o $@
lstadd_back: ft_lstadd_back.c ${LSTLAST}
	${CC} ${CFLAGS} $^ -o $@
	./$@
lstadd_front: ft_lstadd_front.c ${LSTLAST}
	${CC} ${CFLAGS} $^ -o $@
	./$@
lstdelone: ${LSTDELONE}
	${CC} ${CFLAGS} $^ -o $@
	${VALGRIND}
lstclear: ft_lstclear.c ${LSTDELONE}
	${CC} ${CFLAGS} $^ -o $@
	${VALGRIND} ./$@
lstiter: ${LSTITER}
	${CC} ${CFLAGS} $^ -o $@
	./$@
lstlast: ft_lstadd_back.c ${LSTLAST}
	${CC} ${CFLAGS} $^ -o $@
	./$@
lstmap: ft_lstmap.c ${LSTITER}
	${CC} ${CFLAGS} $^ -o $@
	./$@
lstnew: ft_lstnew.c
	${CC} ${CFLAGS} $^ -o $@
	./$@
lstsize: ft_lstsize.c ft_lstadd_back.c ${INIT_NODE}
	${CC} ${CFLAGS} $^ -o $@
	./$@
clean:
	rm ${EXE}
fclean: clean
re: fclean all
.PHONY: default clean fclean re

