CC:= cc
CFLAGS:= -Wall -Werror -Wextra
HEADER:= libft.h
EXE:= lstadd_back lstclear lstadd_front lstdelone lstiter lstlast lstmap lstnew lstsize
INIT_NODE:= ft_init_node.c ft_strdup.c ft_lstnew.c ft_strlen.c
LSTLAST:= ft_lstlast.c ${INIT_NODE}
LSTDELONE:= ft_lstdelone.c ft_free_content.c ${INIT_NODE}
LSTITER:= ft_lstiter.c ft_isalpha.c ft_lstclear.c ft_lstadd_back.c ${LSTDELONE}
VALGRIND = valgrind
default:
	@echo "Please specify which test you are running\nDo not forget to comment out main of the tested file AND ONLY of the tested file!"
lstadd_back: ft_lstadd_back.c ${LSTLAST}
	${CC} ${CFLAGS} $^ -o $@
	./$@
lstadd_front: ft_lstadd_front.c ${LSTLAST}
	${CC} ${CFLAGS} $^ -o $@
	./$@
lstdelone: ${LSTDELONE}
	${CC} ${CFLAGS} $^ -o $@
	${VALGRIND}
lstclear: ft_lstclear.c ${LSTDELONE}
	${CC} ${CFLAGS} $^ -o $@
	${VALGRIND} ./$@
lstiter: ${LSTITER}
	${CC} ${CFLAGS} $^ -o $@
	./$@
lstlast: ft_lstadd_back.c ${LSTLAST}
	${CC} ${CFLAGS} $^ -o $@
	./$@
lstmap: ft_lstmap.c ${LSTITER}
	${CC} ${CFLAGS} $^ -o $@
	./$@
lstnew: ft_lstnew.c
	${CC} ${CFLAGS} $^ -o $@
	./$@
lstsize: ft_lstsize.c ft_lstadd_back.c ${INIT_NODE}
	${CC} ${CFLAGS} $^ -o $@
	./$@
clean:
	rm ${EXE}
fclean: clean
re: fclean all
.PHONY: default clean fclean re

